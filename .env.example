# Public site URL used for canonical, sitemap, Open Graph
NEXT_PUBLIC_SITE_URL=https://remparia.vercel.app

# Contact form (Resend) — required in production for /api/contact
RESEND_API_KEY=
# Verified sender, e.g. Remparia <contact@remparia.fr>
CONTACT_FROM_EMAIL=Remparia <onboarding@resend.dev>

# Matomo Analytics (Cloud or self-hosted)
# Example Cloud: https://votre-instance.matomo.cloud
# Example self-hosted: https://analytics.votredomaine.fr
NEXT_PUBLIC_MATOMO_URL=
# Site ID from Matomo Admin → Websites (often "1")
NEXT_PUBLIC_MATOMO_SITE_ID=

# Vercel Blob — required for careers video upload
# Create a store in Vercel Dashboard → Storage → Blob
BLOB_READ_WRITE_TOKEN=
