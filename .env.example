# --- Formulaires contact + carrières (Resend) ---
# 1. Créer un compte sur https://resend.com
# 2. Ajouter et vérifier le domaine remparia.com (DNS : SPF, DKIM)
# 3. Créer une clé API avec accès "Sending access"
RESEND_API_KEY=re_xxxxxxxx

# Expéditeur vérifié dans Resend (doit correspondre au domaine vérifié)
CONTACT_FROM_EMAIL=Remparia <contact@remparia.com>

# Boîte de réception des soumissions (contact + candidatures)
CONTACT_TO_EMAIL=contact@remparia.com

# --- Formulaire carrières : upload vidéo (Vercel Blob) ---
# Vercel Dashboard → Storage → Blob → Create store → token Read/Write
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx

# Matomo Analytics (Cloud or self-hosted)
# Example Cloud: https://votre-instance.matomo.cloud
# Example self-hosted: https://analytics.votredomaine.fr
NEXT_PUBLIC_MATOMO_URL=
# Site ID from Matomo Admin → Websites (often "1")
NEXT_PUBLIC_MATOMO_SITE_ID=
